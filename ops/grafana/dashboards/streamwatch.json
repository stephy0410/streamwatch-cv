          },
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(sw_e2e_seconds_bucket[1m])))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
